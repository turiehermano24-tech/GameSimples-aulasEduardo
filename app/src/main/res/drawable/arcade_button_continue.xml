<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list><item android:top="3dp"><shape>
            <solid android:color="#3CCBB5" /><stroke android:width="2dp" android:color="#B1FFEB" />
        </shape></item></layer-list>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#5CE4CE" /><stroke android:width="3dp" android:color="#FFFFFF" /></shape>
    </item>
    <item><layer-list>
        <item><shape><solid android:color="#276777" /></shape></item>
        <item android:bottom="4dp" android:right="3dp"><shape>
            <solid android:color="#5CE4CE" /><stroke android:width="1dp" android:color="#B1FFEB" />
        </shape></item>
    </layer-list></item>
</selector>
